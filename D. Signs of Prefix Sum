#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
#include <map>
#include <queue>
#include <set>
#include <stack>
#define ll long long int
#define INF 2e9
using namespace std;

void solve(){ 
	int N;
	string s;
	cin>>N;
	cin>>s;
	if(s[0] == '0' || s.contains("00")){
		cout<<"-1"<<endl;
		return;
	}
	int ans = -1;
	if(s.contains("+-") || s.contains("-+")){
		if(s.contains("+--+") || s.contains("-++-")){
			ans = 3;
		}
		else{
			ans = 2;
		}
	}
	else{
		ans = 1;
		for(int i=0;i<N;i+=2){
			if(s[i] == '0'){
				ans = 2;
				break;
			}
		}
	}
	cout<<ans<<endl;
}

int main(){
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	int tc;
	cin>>tc;
	while(tc--){
		solve();
	}
}
